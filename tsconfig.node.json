{
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025"],
    "module": "preserve",
    "noUncheckedSideEffectImports": true,
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["electron.vite.config.ts", "vitest.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*"]
}
