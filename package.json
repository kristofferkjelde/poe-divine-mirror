{
  "name": "poe-item-checker",
  "version": "0.5.5",
  "private": true,
  "license": "MIT",
  "author": "Kristoffer Kjelde",
  "description": "Path of Exile 2 overlay that compares hovered items against your equipped gear",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite build && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "io.kjelde.poe-item-checker",
    "productName": "Divine Mirror",
    "files": [
      "out/**",
      "resources/**",
      "!**/node_modules/uiohook-napi/prebuilds/{darwin,linux}-*/**",
      "!**/node_modules/uiohook-napi/{src,libuiohook}/**"
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "kristofferkjelde",
      "repo": "poe-divine-mirror",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Divine-Mirror-Setup-${version}.${ext}"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
